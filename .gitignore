# Python caches and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environments and editor state
/.venv/
/venv/
.env
.env.*
.vscode/

# Downloaded raw datasets (keep semantic description JSON and demo samples)
/data/raw/*
!/data/raw/SmellNet/
/data/raw/SmellNet/*
!/data/raw/SmellNet/text_data/
/data/raw/SmellNet/text_data/*
!/data/raw/SmellNet/text_data/text_description.json
/data/interim/
/data/processed/

# Keep demo sample CSVs for Streamlit Cloud
!/data/samples/
!/data/samples/**

# Model artifacts (ignore large local training checkpoints, keep cloud demo models)
/models/*
!/models/baseline_windowed_trialmax/
!/models/baseline_windowed_trialmax/**
!/models/inception_time/
!/models/inception_time/**
!/models/test_mixture/
!/models/test_mixture/**

# Reports and logs
/reports/
*.log
